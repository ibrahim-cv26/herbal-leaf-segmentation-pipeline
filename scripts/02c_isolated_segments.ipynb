# ==========================================
# Phase 2c: Generate Isolated Segments (Colab)
# ==========================================
# Run this script to batch-process all video frames and save purely the isolated color leaf segments.
# PLEASE NOTE THAT ProcessedVideos == ProcessedFrames!!!

import cv2
import numpy as np
import os
import glob
from google.colab import drive

# 1. Mount Google Drive Safely
drive.mount('/content/drive')

# 1. Explicit Directory Setup
# Replace with your actual paths mapping to Google Drive
INPUT_DIR = "/content/drive/MyDrive/CVProject/ProcessedVideos"
SEGMENTED_DIR = "/content/drive/MyDrive/CVProject/IsolatedSegments"

def generate_isolated_segments():
    # 2. File System Safety
    # exist_ok=True prevents crashes if the directory already exists
    os.makedirs(SEGMENTED_DIR, exist_ok=True)

    # Locate all raw frame images (.jpg) recursively in the input directory
    search_pattern = os.path.join(INPUT_DIR, "**", "*.jpg")
    frame_files = glob.glob(search_pattern, recursive=True)

    if not frame_files:
        print(f"No frames found in {INPUT_DIR}")
        return

    print(f"Found {len(frame_files)} frames to process...\n")

    for file_path in frame_files:
        # Load the raw frame
        img_bgr = cv2.imread(file_path)
        if img_bgr is None:
            continue

        # 3. The Processing Loop
        # Step A: Convert from BGR to HSV
        img_hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)

        # Step B: Apply tuned green threshold mask
        lower_green = np.array([35, 40, 40])
        upper_green = np.array([85, 255, 255])
        raw_mask = cv2.inRange(img_hsv, lower_green, upper_green)

        # Step C: Clean mask using Morphological Operations
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
        # Opening: Erases small background specks
        mask_opened = cv2.morphologyEx(raw_mask, cv2.MORPH_OPEN, kernel, iterations=1)
        # Closing: Fills internal leaf holes
        mask_cleaned = cv2.morphologyEx(mask_opened, cv2.MORPH_CLOSE, kernel, iterations=1)

        # Step D: Apply cleaned mask to extract full-color leaves against pure black bg
        color_extracted = cv2.bitwise_and(img_bgr, img_bgr, mask=mask_cleaned)

        # Determine output filename preserving internal structure
        rel_path = os.path.relpath(file_path, INPUT_DIR)
        out_file_path = os.path.join(SEGMENTED_DIR, rel_path)
        out_dir = os.path.dirname(out_file_path)

        os.makedirs(out_dir, exist_ok=True)

        # 4 & 5. Isolated Asset Export and Pristine Filename Preservation
        # Save output image with exactly the same filename
        cv2.imwrite(out_file_path, color_extracted)

        # Simple progress print statement
        filename = os.path.basename(file_path)
        print(f"Successfully isolated segment for {filename}")

if __name__ == "__main__":
    generate_isolated_segments()
