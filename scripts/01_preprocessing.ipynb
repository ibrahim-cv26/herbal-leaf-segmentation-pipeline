# ==========================================
# Phase 1: Preprocessing and downsampling
# ==========================================
# This mounts my GoogleDrive and for each video, extracts 1 frame per second at 
# exactly 640x480 resolution (maximizing efficiency) while strictly retaining the 
# full RGB color channels required for the Segmentation.
#PLEASE NOTE THAT ProcessedVideos == ProcessedFrames!!!

from google.colab import drive
import cv2
import os
import glob
import matplotlib.pyplot as plt

# 1. Mounting Google Drive
drive.mount('/content/drive')

def process_videos_in_folder(input_folder, output_base_folder, target_fps=1, target_size=(640, 480)):
    """
    Downsamples all raw videos in the dataset folder into lightweight BGR frames.
    Saves the frames into one folder per video.
    """
    if not os.path.exists(output_base_folder):
        os.makedirs(output_base_folder)
        
    # Find all video files
    video_files = glob.glob(os.path.join(input_folder, "*.mp4")) + glob.glob(os.path.join(input_folder, "*.avi"))
    
    print(f"Found {len(video_files)} videos in {input_folder}\n")
    
    first_frame_shown = False
    
    for video_path in video_files:
        video_name = os.path.splitext(os.path.basename(video_path))[0]
        video_out_dir = os.path.join(output_base_folder, video_name)
        
        if not os.path.exists(video_out_dir):
            os.makedirs(video_out_dir)
            
        cap = cv2.VideoCapture(video_path)
        if not cap.isOpened():
            print(f"Error: Could not open {video_path}")
            continue
            
        original_fps = cap.get(cv2.CAP_PROP_FPS)
        if original_fps == 0:
            original_fps = 30 # fallback
            
        frame_interval = max(1, int(original_fps / target_fps))
        
        frame_count = 0
        saved_count = 0
        
        while True:
            ret, frame = cap.read()
            if not ret:
                break # End of video
                
            if frame_count % frame_interval == 0:
                # Spatial downsampling to 640x480
                resized_frame = cv2.resize(frame, target_size, interpolation=cv2.INTER_AREA)
                
                # We are not converting to grayscale here because Leaf Segmentation
                # via Color Spaces requires full RGB colors.
                
                # Save frame
                out_filename = os.path.join(video_out_dir, f"frame_{saved_count:04d}.jpg")
                cv2.imwrite(out_filename, resized_frame)
                saved_count += 1
                
                # Visually shows the very first extracted frame
                if not first_frame_shown:
                    plt.figure(figsize=(6, 4))
                    # Convert RGB for correct matplotlib rendering
                    rgb_frame = cv2.cvtColor(resized_frame, cv2.COLOR_BGR2RGB)
                    plt.imshow(rgb_frame)
                    plt.title("Visual Confirmation: Very First Extracted Frame")
                    plt.axis('off')
                    plt.show()
                    first_frame_shown = True
                
            frame_count += 1
            
        cap.release()
        print(f"✅ Processed '{video_name}': Extracted {saved_count} frames -> '{video_out_dir}'")
        
    print("\nAll videos processed successfully!")

# ==========================================
# Google Drive Structure Setup
# ==========================================
if __name__ == "__main__":
    # Typically, Drive root is '/content/drive/MyDrive/'
    RAW_VIDEOS_DIR = "/content/drive/MyDrive/CVProject/RawVideos"
    PROCESSED_FRAMES_DIR = "/content/drive/MyDrive/CVProject/ProcessedVideos"
    
    process_videos_in_folder(
        input_folder=RAW_VIDEOS_DIR,
        output_base_folder=PROCESSED_FRAMES_DIR,
        target_fps=1,          # Extract 1 frame every second
        target_size=(640, 480) # Downsample to standard low resolution
    )
