# ==========================================
# Phase 2: Interactive Segmentation
# ==========================================
# Running this cell launches the interactive HSV thresholding tool. THIS IS OUR MAIN/PRIMARY color-segmentation pipeline .
# It is the basis for the screenshots in the presentation. Check our the Interactive Slider Widget!
# PLEASE NOTE THAT ProcessedVideos == ProcessedFrames!!!

from google.colab import drive
import cv2
import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import interact, IntRangeSlider, IntSlider, Checkbox
import ipywidgets as widgets

# Mounting Google Drive
drive.mount('/content/drive')

def interactive_segmentation(image_path):
    img_bgr = cv2.imread(image_path)
    if img_bgr is None:
        print(f"Error loading image: {image_path}")
        return
        
    img_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)
    img_hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)
    
    def process_and_display(h_range, s_range, v_range, kernel_size, apply_open, apply_close):
        # 1. Bounds
        lower_bound = np.array([h_range[0], s_range[0], v_range[0]])
        upper_bound = np.array([h_range[1], s_range[1], v_range[1]])
        
        # 2. Mask
        mask = cv2.inRange(img_hsv, lower_bound, upper_bound)
        
        # 3. Morphological Operations
        k_size = kernel_size if kernel_size % 2 != 0 else kernel_size + 1
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (k_size, k_size))
        
        if apply_open:
            mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)
        if apply_close:
            mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=1)
            
        # 4. Apply Mask
        result = cv2.bitwise_and(img_rgb, img_rgb, mask=mask)
        
        # 5. Visualizer
        fig, axes = plt.subplots(1, 3, figsize=(18, 6))
        
        axes[0].imshow(img_rgb)
        axes[0].set_title('Original Image')
        axes[0].axis('off')
        
        axes[1].imshow(mask, cmap='gray')
        axes[1].set_title(f'Mask (H:{h_range}, S:{s_range}, V:{v_range})')
        axes[1].axis('off')
        
        axes[2].imshow(result)
        axes[2].set_title('Segmented Result')
        axes[2].axis('off')
        
        plt.tight_layout()
        plt.show()

    # Ipywidgets Interface
    interact(
        process_and_display,
        h_range=IntRangeSlider(value=[35, 85], min=0, max=179, step=1, description='Hue:'),
        s_range=IntRangeSlider(value=[40, 255], min=0, max=255, step=1, description='Saturation:'),
        v_range=IntRangeSlider(value=[40, 255], min=0, max=255, step=1, description='Value:'),
        kernel_size=IntSlider(value=5, min=1, max=21, step=2, description='Kernel Size:'),
        apply_open=Checkbox(value=True, description='Apply Opening (Remove Background Noise)'),
        apply_close=Checkbox(value=True, description='Apply Closing (Fill Leaf Holes)')
    )

# Replace with the path to any of the output frames in Drive to test
SAMPLE_IMAGE_PATH = "/content/drive/MyDrive/CVProject/ProcessedVideos/VID_20260408_173452/frame_0004.jpg"
interactive_segmentation(SAMPLE_IMAGE_PATH)
